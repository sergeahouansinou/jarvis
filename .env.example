# Jarvis tourne entierement en local : aucune cle API, aucun appel reseau.

# --- Modeles de langage (MLX, telecharges une fois puis mis en cache) ---
# Reflexe : reponses courtes, ~200 ms. Tient dans ~2,5 Go.
JARVIS_MODEL_FAST=mlx-community/Qwen3-4B-Instruct-2507-4bit
# Raisonnement : outils, memoire, consolidation. ~4,5 Go.
# Si vous avez de la marge (32 Go+), montez a Qwen3-14B-Instruct-4bit.
JARVIS_MODEL_DEEP=mlx-community/Qwen3-8B-4bit

# --- Transcription ---
JARVIS_STT_MODEL=mlx-community/whisper-large-v3-turbo

# --- Embeddings pour la memoire semantique ---
JARVIS_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Reseau du daemon (le HUD s'y connecte, en boucle locale uniquement) ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787

# --- Voix de repli macOS si aucun TTS neuronal n'est installe ---
JARVIS_SAY_VOICE=Thomas
